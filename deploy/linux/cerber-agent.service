# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Cerber inventory and update reporting agent
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=cerber
Group=cerber
WorkingDirectory=/var/lib/cerber
ExecStart=/opt/cerber/cerber agent run -config /etc/cerber/agent.json
Restart=on-failure
RestartSec=30
TimeoutStopSec=35
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cerber
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
